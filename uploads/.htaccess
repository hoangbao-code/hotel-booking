# Chặn hoàn toàn việc thực thi script độc hại trong thư mục uploads
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phar|pl|py|jsp|asp|htm|html|shtml|sh|cgi)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Vô hiệu hóa PHP engine nếu mod_php được kích hoạt
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
